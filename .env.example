# Copy to .env and adjust values for your machine.
# Never commit the real .env file.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# CORS - add your Flutter app / web origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Firebase Identity Toolkit web API key (login endpoint).
# From Firebase Console > Project settings > General > Web API Key.
# FIREBASE_WEB_API_KEY=AIzaSyAXQN3jPOaNlydGwYChJDEO0gTmuVDC4tE

# ---------------------------------------------------------------------------
# Firebase (FCM push notifications) - OPTIONAL but needed for push.
# The frontend Firebase project is: campusgo-86968  (sender id 186247273220)
# Download a service account key from Firebase Console > Project settings >
# Service accounts > Generate new private key, then point the backend at it.
#
# Provide ONE of:
#   GOOGLE_APPLICATION_CREDENTIALS  = path to the downloaded JSON key
#   FIREBASE_CREDENTIALS_PATH       = path to the downloaded JSON key
#   FIREBASE_SERVICE_ACCOUNT_JSON   = the raw JSON content
#   FIREBASE_SERVICE_ACCOUNT_B64    = base64-encoded JSON content
#
# If none are set, the API still works; push notifications are simply skipped.
# ---------------------------------------------------------------------------
# GOOGLE_APPLICATION_CREDENTIALS=C:\secrets\campusgo-firebase-adminsdk.json
# FIREBASE_SERVICE_ACCOUNT_B64=

# ---------------------------------------------------------------------------
# Production (Render) - set these in the Render dashboard / render.yaml.
# ---------------------------------------------------------------------------
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=.onrender.com
# DATABASE_URL=postgresql://...   (injected automatically by Render)
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB_NAME=campusgo
# FIREBASE_SERVICE_ACCOUNT_B64=<base64 of the service-account JSON>
#   Generate with: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
